            "icd10": "B38.9",
            "snomed": "5294002",
            "category": "fungal",
            "az_status": "highly endemic; reportable",
            "transmission_routes": [
                {"route": "environmental_exposure", "vehicle": "soil dust (Coccidioides spp. arthroconidia)", "primary": true},
                {"route": "aerosol",                "vehicle": "wind-blown dust during soil disturbance", "primary": true}
            ],
            "host_species": {
                "human":           {"susceptible": true, "severity_pct_severe": 5,  "incubation_days": [21, 7, 28]},
                "dog":             {"susceptible": true, "severity_pct_severe": 8,  "incubation_days": [21, 7, 60]},
                "cat":             {"susceptible": true, "severity_pct_severe": 3,  "incubation_days": [21, 14, 60]},
                "horse":           {"susceptible": true, "severity_pct_severe": 5,  "incubation_days": [30, 14, 90]},
                "cattle":          {"susceptible": true, "severity_pct_severe": 1,  "incubation_days": [30, 14, 90]}
            },
            "reservoir":  "soil (saprophyte)",
            "vectors":    [],
            "environmental_drivers": ["soil_disturbance", "drought_then_rain", "construction", "windstorm"],
            "sentinel": {
                "direction": "shared_environmental",
                "rationale": "Both species inhale arthroconidia from the same soil-dust event. A clustered animal case in a household elevates prior on the human's environmental exposure. A spike in animal cases in a county is a near-real-time proxy for human community risk; the canine seroprevalence map historically leads the human-incidence map by 2–6 weeks because dogs sniff the ground."
            },
            "az_geography": ["Pima", "Pinal", "Maricopa", "Yuma"],
            "person_to_person": false
        },
        {
            "id": "rmsf",
