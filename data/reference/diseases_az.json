            "transmission_routes": [
                {"route": "vector_borne", "vehicle": "Rhipicephalus sanguineus (brown dog tick) bite", "primary": true},
                {"route": "direct_contact","vehicle": "crushing engorged tick releases organisms onto skin", "primary": false}
            ],
            "host_species": {
                "human":  {"susceptible": true, "severity_pct_severe": 30, "incubation_days": [5, 2, 14], "fatal_pct_untreated": 30},
                "dog":    {"susceptible": true, "severity_pct_severe": 25, "incubation_days": [5, 2, 14]}
            },
            "reservoir":  "domestic dogs (peridomestic cycle in AZ)",
            "vectors":    ["Rhipicephalus sanguineus"],
            "environmental_drivers": ["dog_population_density", "outdoor_dog_housing", "tick_burden_index"],
            "sentinel": {
                "direction": "animal_to_human",
                "rationale": "In Arizona's brown-dog-tick cycle, human cases occur AFTER weeks of unrecognized canine RMSF in the same household or community. A rising community-level dog-RMSF rate is the strongest near-term predictor of human cases. ADHS mandates community-level acaricide treatment of dog populations during outbreaks specifically because dogs are the sentinels."
            },
            "az_geography": ["Pinal", "Maricopa", "Pima", "Apache", "Navajo", "Cochise"],
            "person_to_person": false
        },
